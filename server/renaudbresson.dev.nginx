# ─── Frontend Vue.js (SPA prérendue) — www.renaudbresson.dev ─────────────────
# Config finale, générée par `certbot --nginx -d renaudbresson.dev -d www.renaudbresson.dev`
# le 2026-09-04 puis rapatriée ici (voir server/README.md). Un correctif manuel :
# certbot avait copié la redirection du domaine nu telle quelle dans le bloc HTTPS,
# renvoyant donc vers du http:// depuis une connexion https:// — corrigé ci-dessous.
server {
    server_name www.renaudbresson.dev;

    root /var/www/portfolio-frontend;
    index index.html;

    # $uri/index.html sert le prerendu (ex. dist/en/about/index.html sur
    # /en/about) ; /index.html en repli assure le fonctionnement SPA pour
    # tout ce qui n'est pas une des routes prerendues. Voir CLAUDE.md,
    # section "Référencement et prérendu".
    location / {
        try_files $uri $uri/index.html /index.html;
    }

    # Script du formulaire de contact (voir server/contact.php, server/README.md)
    # — hors de /var/www/portfolio-frontend pour ne pas etre efface par le
    # `rsync --delete` qui resynchronise dist/ a chaque deploiement du front.
    location = /contact.php {
        root /var/www/portfolio-scripts;
        fastcgi_index contact.php;
        fastcgi_pass unix:/var/run/php/php8.5-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/contact.php;
    }

    # Pas de journal d'accès : évite de journaliser l'adresse IP des visiteurs
    # (voir runtime-tests.md, decision retention des journaux) — supprime au
    # passage tout engagement de duree/rotation a tenir dans la politique de
    # confidentialite. error_log garde un diagnostic minimal (pas de volume
    # systematique par visite, contrairement a l'access log).
    access_log off;
    error_log /var/log/nginx/renaudbresson.dev.error.log;

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/renaudbresson.dev/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/renaudbresson.dev/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# ─── Domaine nu -> www (redirection, comme le faisait Vercel) ────────────────
server {
    server_name renaudbresson.dev;

    # Corrige le bug certbot : la redirection generee pointait vers http://
    # depuis ce bloc https://, cassant le domaine nu en HTTPS.
    return 301 https://www.renaudbresson.dev$request_uri;

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/renaudbresson.dev/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/renaudbresson.dev/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = renaudbresson.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name renaudbresson.dev;
    return 404; # managed by Certbot
}

server {
    if ($host = www.renaudbresson.dev) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name www.renaudbresson.dev;
    return 404; # managed by Certbot
}
